    "@aws-sdk/client-sesv2": "^3.1142.0",
    "@aws-sdk/client-transcribe-streaming": "^3.1141.0",
    "@aws-sdk/s3-request-presigner": "^3.1130.0",
    "ai": "7.0.92",
    "cookie": "^0.7.2",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "google-auth-library": "^11.0.2",
    "jose": "^6.2.10",
    "mongoose": "^9.10.0",
    "multer": "^2.2.0",
    "ollama-ai-provider-v2": "^4.0.1",
    "pg": "^8.23.0",
    "stripe": "22.6.2",
    "tropical-love-pet": "file:..",
    "ws": "^8.22.0",
    "zod": "4.4.3"
  },
