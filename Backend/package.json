{
  "name": "backend",
  "version": "1.0.0",
  "type": "module",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test": "npm run test:unit && npm run test:api:postgres",
    "test:unit": "node scripts/run-unit-tests.mjs",
    "test:api:postgres:validate": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/validate-postgres-api-test-schema.mjs",
    "test:api:postgres": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/run-postgres-api-tests.mjs",
    "test:llm": "vitest run src/__tests__/llm.evaluation.test.ts",
    "restore:google-review-fixtures": "tsx src/scripts/restore-google-review-fixtures.ts",
    "auth:provision-password": "tsx src/scripts/provision-user-password.ts",
    "seed:mongo": "tsx src/scripts/seed-mongo-conversations.ts",
    "media:upload-tasks": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --import tsx src/scripts/upload-task-media.ts",
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js"
  },
