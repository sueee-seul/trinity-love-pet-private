PORT=3000
CORS_ORIGIN=http://localhost:5173
NODE_ENV=development
# Set to 1 (one proxy hop) or the proxy addresses when the API runs behind a load balancer, so
# rate limits and the speech socket see each visitor's own address. Leave unset locally.
# TRUST_PROXY=1
POSTGRESQL_URL=our_database_connection_string
GOOGLE_CLIENT_ID=the_client_id_from_google
GOOGLE_CLIENT_SECRET=the_client_secret_from_google
AUTH_SESSION_SECRET=the_secret_for_auth_session
REVIEWER_SESSION_SECRET=the_secret_for_maps_reviewer_session
REVIEW_SIMULATOR_SECRET=the_secret_for_server_side_review_simulator
TEST_DATABASE_URL=the_test_database_connection_string
EXPOSE_LOCAL_PASSWORD_RESET_URL=true
LLM_BASE_URL=http://127.0.0.1:11434/api
LLM_MODEL=qwen2.5-coder:14b
LLM_API_KEY=ollama
# On AWS: the Bedrock Mantle endpoint in Sydney with the course's 12-hour bearer key. The key is
# re-read from this file after a 401, so a new key needs no restart.
# LLM_BASE_URL=https://bedrock-mantle.ap-southeast-2.api.aws/v1
# LLM_MODEL=openai.gpt-oss-120b
# LLM_API_KEY=bedrock-api-key-...
NEON_S3_BUCKET=petown
AWS_ENDPOINT_URL_S3=the_neon_object_storage_endpoint
AWS_ACCESS_KEY_ID=the_neon_object_storage_access_key
AWS_SECRET_ACCESS_KEY=the_neon_object_storage_secret_key
AWS_REGION=us-east-2
# Vaccination certificates are kept on this server's disk, never in the public bucket above, and
# only reach signed-in owners and employees through the API. Optional in development (default:
# Backend/storage/vaccination-certificates). Required with NODE_ENV=production: point it at a
# persistent, backed-up volume.
# VACCINATION_CERTIFICATE_DIR=/var/lib/wagstay/vaccination-certificates
# Photos of what a pet arrived with, kept the same way. Optional in development (default:
# Backend/storage/booking-items), required with NODE_ENV=production.
# BOOKING_ITEM_PHOTO_DIR=/var/lib/wagstay/booking-items
# Live dictation. The default provider is the local Whisper service in SpeechService/ (start it
# with npm run dev:speech); it needs no cloud account or key. Set SPEECH_PROVIDER=transcribe to use
# Amazon Transcribe instead.
# SPEECH_PROVIDER=whisper
# WHISPER_SERVICE_URL=http://127.0.0.1:8765
# Transcribe only. These are real AWS credentials (an IAM user or role with
# transcribe:StartStreamTranscription); they are separate from the AWS_* Neon Object Storage keys
# above, which the SDK would otherwise pick up by mistake. Only ap-southeast-2 (Sydney),
# ap-southeast-4 (Melbourne) or ap-southeast-6 (Auckland) are accepted.
# TRANSCRIBE_AWS_REGION=ap-southeast-2
# TRANSCRIBE_AWS_ACCESS_KEY_ID=the_transcribe_access_key
# TRANSCRIBE_AWS_SECRET_ACCESS_KEY=the_transcribe_secret
# Leave TRANSCRIBE_LANGUAGE_CODE unset to identify the spoken language among
# TRANSCRIBE_LANGUAGE_OPTIONS (default en-US,en-AU,zh-CN,ko-KR,es-US); set it to force one language.
# TRANSCRIBE_LANGUAGE_CODE=en-AU
# TRANSCRIBE_LANGUAGE_OPTIONS=en-US,en-AU,zh-CN,ko-KR,es-US
# TRANSCRIBE_PREFERRED_LANGUAGE=en-US
# AI booking concierge (see docs/ai-booking-concierge.md). Signs quotes, acceptances and email
# verifications; use a random value of at least 32 characters, different from AUTH_SESSION_SECRET.
# The example value below is refused on purpose, so a copied .env cannot sign real quotes.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CONCIERGE_SIGNING_SECRET=a_long_random_secret_for_concierge_tokens
# rules (no model), openai (GPT OSS 120B on Bedrock Mantle through the LLM_* settings above; the
# model may be named with CONCIERGE_OPENAI_MODEL), anthropic (Claude on the owner's own Anthropic
# account, keys below), or bedrock (Claude on Amazon Bedrock, keys further down).
CONCIERGE_AI_PROVIDER=rules
# CONCIERGE_OPENAI_MODEL=openai.gpt-oss-120b
# Anthropic only. A key that is not scoped to one workspace also needs the workspace id
# (Anthropic Console > Settings > Workspaces). Effort is low, medium or high.
# ANTHROPIC_API_KEY=the_anthropic_api_key
# ANTHROPIC_WORKSPACE_ID=wrkspc_your_workspace_id
# CONCIERGE_ANTHROPIC_MODEL=claude-sonnet-5-5
# CONCIERGE_ANTHROPIC_EFFORT=low
# Email for verification codes and booking reminders. ses sends through Amazon SES from
# CONCIERGE_EMAIL_FROM, a sender verified in SES (SES also needs production access to mail guests).
# The SES keys are separate from the AWS_* Neon Object Storage keys above, which the SDK would
# otherwise pick up by mistake. Region defaults to ap-southeast-2 (Sydney).
# CONCIERGE_EMAIL_MODE=ses
# CONCIERGE_EMAIL_FROM=Wagstay <bookings@your-facility.co.nz>
# CONCIERGE_SES_REGION=ap-southeast-2
# CONCIERGE_SES_ACCESS_KEY_ID=the_aws_access_key_for_ses
# CONCIERGE_SES_SECRET_ACCESS_KEY=the_aws_secret_key_for_ses
# Local development only: CONCIERGE_EMAIL_MODE=console prints emails on the server console instead.
# Ignored when NODE_ENV=production; without an email provider, codes are then not sent and the page
# offers "send this plan to our team" instead, and reminder emails wait (cards are still held).
# CONCIERGE_EMAIL_MODE=console
# The team's real contact, shown by "Talk to a person" and used for "send this plan".
# CONCIERGE_TEAM_EMAIL=bookings@your-facility.co.nz
# CONCIERGE_TEAM_PHONE=09 555 0100
# Who receipts come from (New Zealand GST Act s 19K, Australian Consumer Law s 100). Until these are
# set the emails say "to be confirmed"; set them before taking real money.
# BUSINESS_LEGAL_NAME=Wagstay Limited
# BUSINESS_TAX_NUMBER=123-456-789
# BUSINESS_ADDRESS=1 Example Street, Auckland 1010
# Card payments. A booking saves the guest's card and holds the price 48 hours before drop-off.
# Use Stripe test keys (sk_test_ / pk_test_) until the business is ready: they move no real money,
# and the page says it is a test. Both keys are needed; the publishable key is sent to the page.
# STRIPE_SECRET_KEY=sk_test_your_secret_key
# STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key
# Local development only, before you have Stripe keys: pretend every card is saved and held.
# Ignored when NODE_ENV=production. Without either, online booking says cards are not set up.
# CONCIERGE_PAYMENT_MODE=fake
# Every 15 minutes the API holds cards 48 hours before drop-off, emails the reminder, and flags
# unrecorded arrivals for managers. Only one server runs it at a time. Set to off to keep this
# server out of it, for example a local server on a shared database.
# BOOKING_JOBS=off
# Bedrock only. Keep inference in Australia/New Zealand: the privacy notice says so.
# Every other model call (reading a medicine label, writing the daily update) uses BEDROCK_* and
# falls back to the CONCIERGE_BEDROCK_* values below. Without either, those features say they are
# not set up and the parent types the details instead.
# BEDROCK_REGION=ap-southeast-2
# BEDROCK_MODEL=anthropic.claude-opus-5
# BEDROCK_API_KEY=the_bedrock_api_key
# CONCIERGE_BEDROCK_REGION=ap-southeast-2
# CONCIERGE_BEDROCK_MODEL=anthropic.claude-opus-5
# CONCIERGE_BEDROCK_EFFORT=low
# Either a Bedrock API key, or an access key pair (never the Neon AWS_* keys above).
# CONCIERGE_BEDROCK_API_KEY=the_bedrock_api_key
# CONCIERGE_BEDROCK_ACCESS_KEY_ID=the_aws_access_key_for_bedrock
# CONCIERGE_BEDROCK_SECRET_ACCESS_KEY=the_aws_secret_key_for_bedrock
MONGO_URI=mongodb+srv://<db_username>:<db_password>@tropicalagent.chna0bz.mongodb.net/tropical_love_pet_agent

# KPI reports (daily summary). Separate from MONGO_URI; the feature is off without KPI_MONGO_URI.
KPI_MONGO_URI=mongodb+srv://<db_username>:<db_password>@<cluster>.mongodb.net/<database>
# Gemini via its OpenAI-compatible endpoint. Use a model Google AI Studio lists as free.
KPI_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
KPI_LLM_MODEL=<gemini_model_name>
KPI_LLM_API_KEY=<google_ai_studio_api_key>
# KPI_SUMMARY_JOB=off
# KPI_ALERTS_JOB=off
# KPI_REPORTS_JOB=off
# KPI report email. console prints it in the Backend log; resend sends it through Resend.
KPI_EMAIL_MODE=console
# RESEND_API_KEY=<resend_api_key>
# KPI_REPORT_FROM=onboarding@resend.dev
# Without a verified domain Resend only delivers to the account's own email; send every report there.
# KPI_REPORT_TEST_RECIPIENT=<your_resend_account_email>
# KPI_REPORT_APP_URL=http://localhost:5173
# Added on main by the KPI and notification work; placeholders only, real values go in .env.
# AWS_SESSION_TOKEN=your_aws_session_token
